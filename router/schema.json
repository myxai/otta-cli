{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RouterOutputV4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "route",
    "intent",
    "risk",
    "need_confirm",
    "case_key",
    "slots"
  ],
  "properties": {
    "route": {
      "type": "string",
      "enum": [
        "golden",
        "llm",
        "block"
      ]
    },
    "intent": {
      "type": "string",
      "enum": [
        "chat",
        "operate",
        "fs",
        "search",
        "cron",
        "sys",
        "unknown"
      ]
    },
    "risk": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "need_confirm": {
      "type": "boolean"
    },
    "case_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "slots": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      },
      "maxProperties": 12
    }
  }
}
